# Default: balanced reasoning/agent model, verified on NVIDIA GB10 with NIM 2.0.8.
NIM_IMAGE=nvcr.io/nim/nvidia/nemotron-3-nano:2.0.8
MODEL_NAME=nvidia/nemotron-3-nano
# Runnable 21 GB TP1 NVFP4 profile reported by list-model-profiles on the target Spark.
# Re-verify this image-specific hash before changing NIM_IMAGE.
NIM_MODEL_PROFILE=1fba9ecfcfb4cde28d4ce3fd55c40bca89a5a613e25e98f057befe6a7e99eada
# Nemotron 3 reasoning separation plus automatic tool selection for Open WebUI
# and future native bot tools.
NIM_PASSTHROUGH_ARGS=--reasoning-parser nemotron_v3 --enable-auto-tool-choice --tool-call-parser qwen3_coder
REASONING_STYLE=nemotron3
# GB10 workaround for CUDA-graph startup failures in this NIM line.
NIM_DISABLE_CUDA_GRAPH=1
TEMPERATURE=1.0
TOP_P=0.95
