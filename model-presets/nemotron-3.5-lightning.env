# Newer 30B-A3B model; early-access container as of 2026-08-23.
NIM_IMAGE=nvcr.io/nim/nvidia/nemotron-3.5-lightning-30b-a3b:2.0.9-variant
MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_SERVED_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
# Required by NVIDIA's 2.0.10 getting-started guide to separate reasoning output.
NIM_PASSTHROUGH_ARGS=--reasoning-parser nemotron_v3
REASONING_STYLE=nemotron3
TEMPERATURE=1.0
TOP_P=0.95
