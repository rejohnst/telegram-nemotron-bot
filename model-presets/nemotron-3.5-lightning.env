# Newer 30B-A3B model; early-access container as of 2026-08-23.
NIM_IMAGE=nvcr.io/nim/nvidia/nemotron-3.5-lightning-30b-a3b:2.0.9-variant
MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_SERVED_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA's launch settings for reasoning separation and automatic tool selection.
NIM_PASSTHROUGH_ARGS=--reasoning-parser nemotron_v3 --enable-auto-tool-choice --tool-call-parser qwen3_coder
REASONING_STYLE=nemotron3
TEMPERATURE=1.0
TOP_P=0.95
# Verified TP1 NVFP4 profile for GB10 with NIM 2.0.9-variant.
NIM_MODEL_PROFILE=920207996e4ec77b396e25f4e360ac80331a67dcae0fec428803f556afe1d47c
