# ---- Copy to .env and fill in -------------------------------------------------

# NVIDIA NGC API key (https://ngc.nvidia.com -> Setup -> Generate API Key).
# NIM uses this to pull the container/model from nvcr.io.
NGC_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# ---- Optional overrides (sane defaults already set) ---------------------------

# NIM container image. Default is Nemotron 3 Nano 30B-A3B (MoE, ~3.5B active) —
# sized for the Spark, reasoning + tool calling together. VERIFY THE TAG on the
# Spark: list tags and pick the GB10 build (look for a "-variant" tag), confirm with
# `docker compose run --rm nim list-model-profiles`. See models.md for alternatives.
# NIM_IMAGE=nvcr.io/nim/nvidia/nemotron-3-nano:latest

# Model name as served by NIM (must match the NIM's advertised model id —
# verify with: docker compose exec nim curl -s localhost:8000/v1/models).
# MODEL_NAME=nvidia/nemotron-3-nano

# Context window cap, in tokens (KV-cache memory). The model supports up to 1M,
# but on the Spark a too-large value can stop NIM from starting (KV cache won't fit)
# and reduces how many requests run concurrently. 128K is a comfortable default;
# use 65536 (64K) to free more memory, or 262144 (256K) if you need long documents.
# See INSTALL.md §10 "Tuning the context size".
# NIM_MAX_MODEL_LEN=131072

# KV-cache pool as a fraction of GPU memory. CRITICAL on the Spark: unified memory
# means "GPU memory" = system RAM, so the usual ~0.9 default over-reserves and sends
# the box into swap. Keep low (0.3-0.5). See INSTALL.md §10.
# NIM_KVCACHE_PERCENT=0.4

# Force eager mode (maps to vLLM --enforce-eager). REQUIRED on GB10/Spark — vLLM's
# torch.compile/Inductor warmup crashes on sm_121 ("InductorError: AssertionError").
# The correct var is NIM_DISABLE_CUDA_GRAPH (NOT NIM_ENFORCE_EAGER). Default 1.
# NIM_DISABLE_CUDA_GRAPH=1

# Extra vLLM args passed through to the engine. Used to enable tool/function calling
# (agentic mode) on the Nano, which the NIM doesn't auto-configure. The Nano's
# tool-call parser is "qwen3_coder". Without this, agentic mode errors with
# '"auto" tool choice requires --enable-auto-tool-choice and --tool-call-parser'.
# NIM_PASSTHROUGH_ARGS=--enable-auto-tool-choice --tool-call-parser qwen3_coder

# Reasoning convention for the chosen model:
#   nemotron3 = Nemotron 3 (chat_template_kwargs.enable_thinking; default)
#   directive = Llama-Nemotron Super 49B ("detailed thinking on/off" phrase)
#   none      = no reasoning control (/think becomes a no-op)
# REASONING_STYLE=nemotron3

# Sampling. Nemotron 3 recommends 1.0 / 0.95; the 49B preferred ~0.6 / 1.0.
# TEMPERATURE=1.0
# TOP_P=0.95
# Optional reasoning length cap for nemotron3 (256-16384). Empty = model default.
# REASONING_BUDGET=

# System persona.
# SYSTEM_PROMPT=You are a helpful, concise assistant.

# How many user+assistant turns of history to send as context.
# MAX_HISTORY_TURNS=12

# Lock the bot to specific Telegram user IDs (comma-separated). Empty = anyone
# who finds the bot can use it. Strongly recommended to set this.
# Get your numeric ID by messaging @userinfobot on Telegram.
# ALLOWED_USER_IDS=123456789
